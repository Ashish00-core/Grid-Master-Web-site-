{
  "name": "grid-master-solar",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "serve": "vite preview --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "lint": "eslint .",
    "test": "node --test \"tests/*.test.mjs\" \"tests/dom/*.test.mjs\" \"tests/server/*.test.mjs\"",
    "test:unit": "node --test \"tests/*.test.mjs\"",
    "test:dom": "node --test \"tests/dom/*.test.mjs\"",
    "test:server": "node --test \"tests/server/*.test.mjs\"",
    "verify": "npm run lint && npm test && npm run build",
    "preview": "vite preview --host 0.0.0.0 --port 3000"
  },
  "dependencies": {
    "lucide-react": "^0.344.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.6",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.6"
  }
}
